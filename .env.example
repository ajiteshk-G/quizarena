# Server Port
PORT=8085

# Invite-Only Super Admin Account (seeded automatically on first boot)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME=Platform Admin
ADMIN_PASSWORD=replace-with-strong-password

# Optional comma-separated list of pre-approved creator emails
AUTHORIZED_EMAILS=creator1@example.com,creator2@example.com

# Google Cloud / Vertex AI Configuration (for AI Quiz Generation & GCS Persistence)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_MODEL_ID=gemini-3.8-flash

# Optional Cloud Storage bucket for durable multi-revision persistence on Cloud Run
# Leave empty in local development to persist to ./data/store.json
GCS_BUCKET=
